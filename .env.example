# Keep this token STABLE. Grok stores it in the connector; rotating it means
# re-registering the connector.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LOCUM_TOKEN=replace-me

# Colon-separated allowlist. Everything outside these paths is refused.
# This is the only thing between a cloud agent and your home directory.
LOCUM_ROOTS=/Users/YOU/Documents/Projects

LOCUM_HOST=127.0.0.1
LOCUM_PORT=8791

# bypass | ask
#
# A delegated job has nobody at the keyboard, so anything that stops to ask for
# approval does not pause, it hangs until LOCUM_JOB_TIMEOUT. "bypass" runs
# claude with --dangerously-skip-permissions and codex with
# --dangerously-bypass-approvals-and-sandbox, which is the only setting where
# delegation reliably completes.
#
# Understand what that means: the agent can run any command as you. LOCUM_ROOTS
# still bounds which directory it starts in, but a shell command is not confined
# by it. Keep the roots narrow, keep the token secret, and read SECURITY.md.
#
# "ask" restores prompting (claude --permission-mode, codex --sandbox
# workspace-write). Use it only from a client that can surface the prompts.
LOCUM_AUTONOMY=bypass

# Only consulted when LOCUM_AUTONOMY=ask.
LOCUM_PERMISSION_MODE=acceptEdits

LOCUM_JOB_TIMEOUT=1800
LOCUM_MAX_CONCURRENT=2

# How many finished jobs to keep in memory for list_jobs. Under launchd the
# process can run for weeks, so history is capped. Running jobs are never
# dropped.
LOCUM_MAX_JOBS=200

# Where job metadata is journaled (one JSON object per line), so history and
# session ids survive a restart and resume_* works after a reboot. Jobs that
# were mid-flight come back as errors; transcripts stay in memory only.
# LOCUM_JOBS_FILE=~/.locum/jobs.jsonl

# POST one JSON payload here when a job finishes (done, error, or timeout),
# so the orchestrator can sleep instead of polling. Point it at your own
# routine; the payload mirrors check_job. Empty disables it.
# LOCUM_COMPLETION_WEBHOOK=https://your-routine-here

# Narrate delegated work on stdout: the prompt, each tool call the agent makes,
# and a finish line with turns, duration, and reported cost. This is what makes
# it visible that work is running on your machine rather than in the cloud.
# Set to 0 for uvicorn access logs only.
LOCUM_NARRATE=1

# How many transcript events to keep per job for the dashboard. Bounded because
# the process runs for weeks and a chatty agent emits thousands.
LOCUM_MAX_EVENTS=400

# Optional, and required only if you run the server under launchd via
# install-agent.sh. A launchd agent does not get your login session's
# credential access, so a spawned `claude` fails with "OAuth session expired
# and could not be refreshed" even though the same delegation works from a
# terminal. Mint a long-lived token with `claude setup-token` and paste it here.
#
# This makes .env, and the plist install-agent.sh generates from it, as
# sensitive as a vendor credential. Both are chmod 600. Leave this unset if you
# run the server from a terminal.
# CLAUDE_CODE_OAUTH_TOKEN=
