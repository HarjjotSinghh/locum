# Keep this token STABLE. Grok stores it in the connector; rotating it means
# re-registering the connector.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LOCUM_TOKEN=replace-me

# Colon-separated allowlist. Everything outside these paths is refused.
# This is the only thing between a cloud agent and your home directory.
LOCUM_ROOTS=/Users/YOU/Documents/Projects

LOCUM_HOST=127.0.0.1
LOCUM_PORT=8791

# acceptEdits | auto | manual | plan | dontAsk | bypassPermissions
# Never use bypassPermissions with a tunnel open.
LOCUM_PERMISSION_MODE=acceptEdits

LOCUM_JOB_TIMEOUT=1800
LOCUM_MAX_CONCURRENT=2
