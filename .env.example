# Keep this token STABLE. Grok stores it in the connector; rotating it means
# re-registering the connector.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LOCUM_TOKEN=replace-me

# Colon-separated allowlist. Everything outside these paths is refused.
# This is the only thing between a cloud agent and your home directory.
LOCUM_ROOTS=/Users/YOU/Documents/Projects

LOCUM_HOST=127.0.0.1
LOCUM_PORT=8791

# acceptEdits | auto | manual | plan | dontAsk | bypassPermissions
# Never use bypassPermissions with a tunnel open.
LOCUM_PERMISSION_MODE=acceptEdits

LOCUM_JOB_TIMEOUT=1800
LOCUM_MAX_CONCURRENT=2

# How many finished jobs to keep in memory for list_jobs. Under launchd the
# process can run for weeks, so history is capped. Running jobs are never
# dropped.
LOCUM_MAX_JOBS=200

# Narrate delegated work on stdout: the prompt, each tool call the agent makes,
# and a finish line with turns, duration, and reported cost. This is what makes
# it visible that work is running on your machine rather than in the cloud.
# Set to 0 for uvicorn access logs only.
LOCUM_NARRATE=1

# Optional, and required only if you run the server under launchd via
# install-agent.sh. A launchd agent does not get your login session's
# credential access, so a spawned `claude` fails with "OAuth session expired
# and could not be refreshed" even though the same delegation works from a
# terminal. Mint a long-lived token with `claude setup-token` and paste it here.
#
# This makes .env, and the plist install-agent.sh generates from it, as
# sensitive as a vendor credential. Both are chmod 600. Leave this unset if you
# run the server from a terminal.
# CLAUDE_CODE_OAUTH_TOKEN=
